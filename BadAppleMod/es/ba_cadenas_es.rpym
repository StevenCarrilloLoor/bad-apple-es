# Bad Apple - traduccion al espanol latinoamericano (menus, nombres y textos sueltos)
# Version del parche: 1.0 (2026-11-22)
# Para: Bad Apple (Team Starlight) sobre Snoot Game Patch 14 (Ren'Py 8.3.7.25031702)
#
# Capa de traduccion independiente: no modifica ningun archivo del mod ni del juego.
# Archivo GENERADO por herramientas/construir.py. No lo edites a mano: la traduccion vive
# en fuente/ y cada bloque de aqui abajo se refiere al guion original por archivo y linea.
# Es un .rpym para que el cargador de mods del juego solo lo cargue con el mod activado.
#
# Bad Apple y Snoot Game pertenecen a sus autores. Esta es una traduccion de fans.

init 900 python hide:

    def ba_es_poner(pares):
        try:
            traductor = renpy.game.script.translator
            cadenas = traductor.strings["es"]
            traductor.languages.add("es")
        except Exception:
            return
        for original, traduccion in pares:
            if original not in cadenas.translations:
                try:
                    cadenas.add(original, traduccion, ("game/mods/BadAppleMod/es/ba_cadenas_es.rpym", 0))
                except Exception:
                    pass

    ba_es_poner([
        # ba_chapterselect:19 (menu)
        ("Select an arc to start from:", "Elige desde qué arco empezar:"),
        # ba_chapterselect:19 (menu)
        ("Start from beginning", "Empezar desde el principio"),
        # ba_chapterselect:19 (menu)
        ("Arc 1: The Tower", "Arco 1: La Torre"),
        # ba_chapterselect:19 (menu)
